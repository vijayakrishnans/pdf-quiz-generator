# https://github.com/vercel-labs/ai-sdk-preview-pdf-support
# Copy to .env.local (git-ignored) for `next dev`. Without a Cloudflare context
# `next dev` has no Workers AI binding, so the quiz route answers 503 unless a
# Google key is set here (README → Use Google's Gemini). On stage and prod the
# key is the product's optional Orun secret, which the deploy pushes to the
# Worker as a secret; the route reads it per request and no build ever sees it.
GOOGLE_GENERATIVE_AI_API_KEY=
# The site's public origin (metadataBase). The deploy sets it per environment;
# unset, it is http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
